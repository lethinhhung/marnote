{
  "name": "marnote",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@wdio/globals": "9.33.1"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @marnote/desktop dev",
    "dev:web": "pnpm --filter @marnote/web dev",
    "test:desktop:e2e": "VITE_WDIO=1 pnpm --filter @marnote/desktop desktop:e2e:build && node scripts/run-desktop-e2e.mjs",
    "build": "pnpm -r build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm -r --workspace-concurrency=1 test:unit && pnpm --filter @marnote/desktop test:rust:unit",
    "test:integration": "pnpm --filter @marnote/mcp test:integration && pnpm --filter @marnote/desktop test:rust:integration",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/mcp": "0.0.84",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/tauri-service": "^1.5.1",
    "eslint": "^9.17.0",
    "expect-webdriverio": "^7.0.1",
    "globals": "^15.14.0",
    "playwright": "1.65.0-alpha-2026-10-30",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8",
    "webdriverio": "^9.33.1"
  }
}
