{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marnote",
  "version": "0.1.0",
  "identifier": "app.marnote.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Marnote", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 500 }]
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
